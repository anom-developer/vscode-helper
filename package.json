{
  "name": "vscode-helper",
  "displayName": "VSCode Helper",
  "description": "Smart code highlighting, suggestions, error detection and auto-fix recommendations for JavaScript, TypeScript, Python, Java, C/C++, Go, and Rust",
  "version": "0.2.0",
  "publisher": "anom-developer",
  "author": "anom-developer",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "linter",
    "helper",
    "suggestions",
    "diagnostics",
    "quickfix",
    "autofix",
    "code quality",
    "clean code",
    "javascript",
    "typescript",
    "python"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:json",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-helper.analyzeFile",
        "title": "%command.analyzeFile%",
        "category": "VSCode Helper"
      },
      {
        "command": "vscode-helper.fixAll",
        "title": "%command.fixAll%",
        "category": "VSCode Helper"
      },
      {
        "command": "vscode-helper.showSuggestions",
        "title": "%command.showSuggestions%",
        "category": "VSCode Helper"
      },
      {
        "command": "vscode-helper.toggle",
        "title": "%command.toggle%",
        "category": "VSCode Helper"
      },
      {
        "command": "vscode-helper.clear",
        "title": "%command.clear%",
        "category": "VSCode Helper"
      },
      {
        "command": "vscode-helper.showStats",
        "title": "%command.showStats%",
        "category": "VSCode Helper"
      },
      {
        "command": "vscode-helper.explainRule",
        "title": "%command.explainRule%",
        "category": "VSCode Helper"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "vscodeHelper.enable": {
          "type": "boolean",
          "default": true,
          "description": "%config.enable%"
        },
        "vscodeHelper.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "Auto-detect from VS Code environment",
            "Русский язык (Russian)",
            "English"
          ],
          "description": "%config.language%"
        },
        "vscodeHelper.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.analyzeOnSave%"
        },
        "vscodeHelper.analyzeOnType": {
          "type": "boolean",
          "default": false,
          "description": "%config.analyzeOnType%"
        },
        "vscodeHelper.severity": {
          "type": "string",
          "default": "hint",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "enumDescriptions": [
            "Only show critical errors",
            "Show errors and warnings",
            "Show errors, warnings, and informational notices",
            "Show all diagnostics including hints"
          ],
          "description": "%config.severity%"
        },
        "vscodeHelper.showDecorations": {
          "type": "boolean",
          "default": true,
          "description": "%config.showDecorations%"
        },
        "vscodeHelper.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStatusBar%"
        },
        "vscodeHelper.maxLineLength": {
          "type": "number",
          "default": 120,
          "description": "%config.maxLineLength%"
        },
        "vscodeHelper.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.disabledRules%"
        }
      }
    },
    "colors": [
      {
        "id": "vscodeHelper.errorBackground",
        "description": "Background highlight for error severity issues",
        "defaults": {
          "dark": "#ff000018",
          "light": "#ff000018",
          "highContrast": "#ff000030"
        }
      },
      {
        "id": "vscodeHelper.warningBackground",
        "description": "Background highlight for warning severity issues",
        "defaults": {
          "dark": "#cca70018",
          "light": "#cca70018",
          "highContrast": "#cca70030"
        }
      },
      {
        "id": "vscodeHelper.infoBackground",
        "description": "Background highlight for information severity issues",
        "defaults": {
          "dark": "#3794ff14",
          "light": "#3794ff14",
          "highContrast": "#3794ff30"
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vscode-helper.analyzeFile",
          "group": "vscode-helper@1"
        },
        {
          "command": "vscode-helper.fixAll",
          "group": "vscode-helper@2"
        },
        {
          "command": "vscode-helper.showSuggestions",
          "group": "vscode-helper@3"
        },
        {
          "command": "vscode-helper.showStats",
          "group": "vscode-helper@4"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anom-developer/vscode-helper.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package --no-dependencies",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "bugs": {
    "url": "https://github.com/anom-developer/vscode-helper/issues"
  },
  "homepage": "https://github.com/anom-developer/vscode-helper#readme",
  "license": "MIT"
}
